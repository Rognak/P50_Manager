DATABASE_URL=postgresql+asyncpg://p50:p50@localhost:5432/p50
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173"]

# DeepSeek / любой OpenAI-compatible endpoint
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL_CHAT=deepseek-chat

REDIS_URL=redis://localhost:6379/0

# CodeBuddy External API
CODEBUDDY_BASE_URL=https://codebuddy.example.com
CODEBUDDY_KEYCLOAK_URL=https://auth.example.com/realms/example
CODEBUDDY_CLIENT_ID=
CODEBUDDY_CLIENT_SECRET=
CODEBUDDY_VERIFY_SSL=false
CODEBUDDY_REQUEST_TIMEOUT=30

# Прямой GitLab API используется только для ручной синхронизации PR со
# статусом Unknown. Без URL/токена кнопка синхронизации будет неактивна.
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_API_TOKEN=
GITLAB_VERIFY_SSL=false
GITLAB_REQUEST_TIMEOUT=15
